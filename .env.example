# Database
DATABASE_URL=postgresql://user:password@localhost:5432/proyectodb

# JWT
SECRET_KEY=your_super_secret_key_here

# API
API_HOST=0.0.0.0
API_PORT=8000

# Flask
FLASK_SECRET_KEY=your_flask_secret_key

# Laravel
APP_NAME=MACUIN
APP_ENV=local
APP_KEY=base64:your_app_key_here
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=proyectodb
DB_USERNAME=user
DB_PASSWORD=password

# Email (para futuras funcionalidades)
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"